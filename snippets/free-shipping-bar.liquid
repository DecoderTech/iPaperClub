
{%- unless cart.empty? -%}
  {%- assign free_shipping_threshold = 29900 -%}
  {%- assign cart_total = cart.total_price -%}
  {%- assign remaining = free_shipping_threshold | minus: cart_total -%}

  <div class="free-shipping-bar">
    {%- if remaining <= 0 -%}
      <p class="free-shipping-bar__message free-shipping-bar__message--achieved">
        Frete grátis conquistado! Aproveite.
      </p>
      <div class="free-shipping-bar__track">
        <div class="free-shipping-bar__fill" style="width: 100%"></div>
      </div>
    {%- else -%}
      {%- assign progress = cart_total | times: 100 | divided_by: free_shipping_threshold -%}
      <p class="free-shipping-bar__message">
        Faltam <strong>{{ remaining | money }}</strong> para frete grátis
      </p>
      <div class="free-shipping-bar__track">
        <div class="free-shipping-bar__fill" style="width: {{ progress }}%"></div>
      </div>
    {%- endif -%}
  </div>
{%- endunless -%}

{% stylesheet %}
  .free-shipping-bar {
    padding: 12px 0 16px;
    font-size: 0.875rem;
  }

  .free-shipping-bar__message {
    margin-block-end: 8px;
    margin-block-start: 0;
    color: var(--color-foreground);
  }

  .free-shipping-bar__message--achieved {
    font-weight: 600;
  }

  .free-shipping-bar__track {
    width: 100%;
    height: 4px;
    background-color: rgb(var(--color-foreground-rgb) / 0.15);
    border-radius: 2px;
    overflow: hidden;
  }

  .free-shipping-bar__fill {
    height: 100%;
    background-color: var(--color-foreground);
    border-radius: 2px;
    transition: width 0.3s ease;
  }
{% endstylesheet %}
