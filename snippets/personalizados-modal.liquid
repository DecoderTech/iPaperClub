<style>
  body.pz-open { overflow: hidden; }

  .pz-modal { position: fixed; inset: 0; z-index: 10000; display: flex; align-items: center; justify-content: center; padding: 16px; }
  .pz-modal[hidden] { display: none !important; }
  .pz-backdrop { position: absolute; inset: 0; background: rgb(0 0 0/.6); cursor: pointer; }
  .pz-dialog {
    position: relative; z-index: 1;
    background: rgb(var(--color-background-rgb,255 255 255));
    width: min(96vw, 980px); height: min(94vh, 720px);
    border-radius: 16px; box-shadow: 0 24px 80px rgb(0 0 0/.35);
    display: flex; flex-direction: column; overflow: hidden;
  }

  /* ── Header ── */
  .pz-hd {
    flex-shrink: 0; height: 54px;
    display: flex; align-items: center; justify-content: space-between;
    padding: 0 20px;
    border-bottom: 1px solid rgb(var(--color-border-rgb,0 0 0)/.1);
  }
  .pz-hd__title { font-size: 13px; font-weight: 700; letter-spacing: .1em; text-transform: uppercase; margin: 0; }
  .pz-hd__close {
    width: 36px; height: 36px; border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    background: none; border: none; cursor: pointer; color: inherit;
    transition: background .15s;
  }
  .pz-hd__close:hover { background: rgb(var(--color-foreground-rgb,0 0 0)/.08); }

  /* ── Steps ── */
  .pz-step { flex: 1; min-height: 0; overflow: hidden; display: flex; }
  .pz-step[hidden] { display: none !important; }

  /* ── Step 1 — Upload / Login ── */
  .pz-s1 { align-items: center; justify-content: center; }
  .pz-login-wrap { display: flex; flex-direction: column; align-items: center; gap: 14px; max-width: 360px; text-align: center; padding: 24px; }
  .pz-login-wrap svg { opacity: .35; }
  .pz-login-wrap h2 { margin: 0; }
  .pz-login-wrap p { opacity: .6; margin: 0; }
  .pz-login-btns { display: flex; flex-direction: column; gap: 8px; width: 100%; }
  .pz-login-btns .button { width: 100%; justify-content: center; }
  .pz-dropzone {
    display: flex; flex-direction: column; align-items: center; gap: 14px;
    border: 2px dashed rgb(var(--color-border-rgb,0 0 0));
    border-radius: 16px; padding: 52px 40px; max-width: 460px; width: 100%;
    text-align: center; cursor: pointer; transition: border-color .2s, background .2s;
  }
  .pz-dropzone.drag-over { border-color: rgb(var(--color-foreground-rgb,0 0 0)); background: rgb(var(--color-foreground-rgb,0 0 0)/.04); }
  .pz-dropzone svg { opacity: .4; }
  .pz-dropzone__title { font-size: var(--font-size--lg); font-weight: 600; margin: 0; }
  .pz-dropzone__sub { font-size: var(--font-size--sm); opacity: .5; margin: 0; }

  /* ── Step 2 — Imagem + seletor de enquadramento ── */
  .pz-s2 { flex-direction: row; }

  .pz-img-stage {
    flex-shrink: 0; width: 56%; height: 100%;
    position: relative; overflow: hidden; background: #1c1c1c;
    display: flex; align-items: center; justify-content: center;
  }
  #pz-full-img {
    display: block; max-width: 100%; max-height: 100%;
    object-fit: contain; pointer-events: none; user-select: none;
  }
  /* frame selector — a janela que define o recorte */
  #pz-frame-sel {
    position: absolute; z-index: 2;
    border: 2px dashed rgba(255,255,255,.85);
    box-shadow: 0 0 0 2000px rgba(0,0,0,.48);
    /* grade de terços */
    background-image:
      linear-gradient(rgba(255,255,255,.08) 1px,transparent 1px),
      linear-gradient(90deg,rgba(255,255,255,.08) 1px,transparent 1px);
    background-size: 33.33% 33.33%;
    cursor: move;
  }
  .pz-fsel-ch {
    position: absolute; z-index: 4;
    width: 22px; height: 22px;
    border-color: #fff; border-style: solid; touch-action: none;
  }
  .pz-fsel-ch[data-corner="nw"] { border-width: 3px 0 0 3px; cursor: nw-resize; }
  .pz-fsel-ch[data-corner="ne"] { border-width: 3px 3px 0 0; cursor: ne-resize; }
  .pz-fsel-ch[data-corner="sw"] { border-width: 0 0 3px 3px; cursor: sw-resize; }
  .pz-fsel-ch[data-corner="se"] { border-width: 0 3px 3px 0; cursor: se-resize; }

  .pz-crop-ctrl {
    flex: 1; min-width: 0; height: 100%;
    display: flex; flex-direction: column; justify-content: center;
    padding: 28px 32px; gap: 20px; overflow: hidden;
  }
  .pz-crop-ctrl h3 { margin: 0; }
  .pz-crop-ctrl > p { margin: 0; font-size: var(--font-size--sm); opacity: .55; }
  .pz-size-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  .pz-size-card {
    display: flex; flex-direction: column; align-items: center; gap: 8px; padding: 14px 10px;
    border: 2px solid rgb(var(--color-border-rgb,0 0 0)); border-radius: 10px;
    cursor: pointer; background: transparent; color: inherit; font-family: inherit;
    transition: border-color .15s, background .15s;
  }
  .pz-size-card:hover { border-color: rgb(var(--color-foreground-rgb,0 0 0)/.35); }
  .pz-size-card.active { border-color: rgb(var(--color-foreground-rgb,0 0 0)); background: rgb(var(--color-foreground-rgb,0 0 0)/.04); }
  .pz-size-card__box { background: rgb(var(--color-foreground-rgb,0 0 0)/.1); border: 1.5px solid rgb(var(--color-foreground-rgb,0 0 0)/.25); border-radius: 2px; flex-shrink: 0; }
  .pz-size-card__name { font-size: var(--font-size--sm); font-weight: 600; }

  /* ── Step 3 — Visualização da moldura ── */
  .pz-s3 { flex-direction: row; }
  .pz-frame-stage {
    flex-shrink: 0; width: 46%; height: 100%;
    overflow: hidden; position: relative; background: #fff;
    display: flex; align-items: center; justify-content: center;
  }
  .pz-frame-inner {
    position: relative;
    width: 68%;
    aspect-ratio: var(--pz-ratio, 2/3);
    flex-shrink: 0;
  }
  .pz-frame-inner img.pz-artwork {
    position: absolute;
    top: 8%; left: 13%; right: 13%; bottom: 8%;
    object-fit: cover; display: block;
  }
  img.pz-moldura-img {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: fill; pointer-events: none; z-index: 1;
  }
  .pz-frame-ctrl {
    flex: 1; min-width: 0; height: 100%;
    display: flex; flex-direction: column;
    padding: 24px 28px; gap: 18px; overflow: hidden;
  }
  .pz-opt-label { font-size: var(--font-size--sm); font-weight: 600; text-transform: uppercase; letter-spacing: .06em; margin: 0; }
  .pz-swatches { display: flex; gap: 10px; flex-wrap: wrap; }
  .pz-swatch { width: 36px; height: 36px; border-radius: 50%; border: 3px solid transparent; cursor: pointer; transition: border-color .15s, transform .15s; background: none; }
  .pz-swatch:hover { transform: scale(1.1); }
  .pz-swatch.active { border-color: rgb(var(--color-foreground-rgb,0 0 0)); }
  .pz-swatch--white { background: #f5f5f0; box-shadow: inset 0 0 0 1px rgb(0 0 0/.12); }
  .pz-swatch--black { background: #1a1a1a; }
  .pz-swatch--oak { background: linear-gradient(135deg,#c8a46e 0%,#a07840 50%,#c8a46e 100%); }
  .pz-sil-wrap { flex: 1; min-height: 0; overflow: hidden; display: flex; align-items: flex-end; }
  .pz-sil-wrap img { max-width: 100%; max-height: 100%; object-fit: contain; object-position: bottom left; display: block; }
  .pz-buy-btn { width: 100%; justify-content: center; flex-shrink: 0; }
  .pz-buy-btn:disabled { opacity: .45; cursor: not-allowed; }

  /* ── Footer ── */
  .pz-ft {
    flex-shrink: 0; height: 58px;
    display: flex; align-items: center;
    padding: 0 16px; gap: 8px;
    border-top: 1px solid rgb(var(--color-border-rgb,0 0 0)/.1);
  }
  .pz-ft__back {
    min-width: 88px;
    display: flex; align-items: center; gap: 6px;
    background: none; border: none; cursor: pointer;
    color: inherit; font-family: inherit;
    font-size: var(--font-size--sm, 14px); font-weight: 500;
    padding: 8px 12px; border-radius: 8px;
    transition: background .15s; white-space: nowrap;
  }
  .pz-ft__back:hover { background: rgb(var(--color-foreground-rgb,0 0 0)/.06); }
  .pz-ft__back[hidden] { visibility: hidden; pointer-events: none; }
  .pz-ft__center { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 4px; }
  .pz-ft__dots { display: flex; align-items: center; gap: 5px; }
  .pz-ft__dot { height: 6px; border-radius: 3px; background: rgb(var(--color-border-rgb,0 0 0)/.3); transition: width .25s, background .25s; width: 6px; }
  .pz-ft__dot.active { width: 20px; background: rgb(var(--color-foreground-rgb,0 0 0)); }
  .pz-ft__label { font-size: 11px; opacity: .5; }
  .pz-ft__next { min-width: 88px; display: flex; justify-content: flex-end; }
  .pz-ft__next .button { display: flex; align-items: center; gap: 6px; }
  .pz-error { font-size: var(--font-size--sm); color: #c0392b; padding: 0 20px 8px; text-align: center; flex-shrink: 0; }
  .pz-error[hidden] { display: none; }

  /* ── Mobile ── */
  @media (max-width: 749px) {
    .pz-modal { padding: 0; align-items: flex-end; }
    .pz-dialog { width: 100%; height: 95dvh; border-radius: 20px 20px 0 0; }
    .pz-s2, .pz-s3 { flex-direction: column; }
    .pz-img-stage, .pz-frame-stage { width: 100% !important; height: 52%; flex-shrink: 0; }
    .pz-crop-ctrl, .pz-frame-ctrl { flex: 1; overflow-y: auto; padding: 14px 16px; }
    .pz-size-grid { grid-template-columns: repeat(4,1fr); }
    .pz-frame-inner { width: 55%; }
  }
</style>

<div id="pz-modal" class="pz-modal" hidden role="dialog" aria-modal="true" aria-label="Quadro Personalizado">
  <div class="pz-backdrop" id="pz-backdrop"></div>
  <div class="pz-dialog">

    <!-- Header -->
    <div class="pz-hd">
      <p class="pz-hd__title">Personalizados</p>
      <button class="pz-hd__close" id="pz-close" type="button" aria-label="Fechar">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M13 3L3 13M13 13L3 3" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
      </button>
    </div>

    <!-- Step 1: Upload / Login -->
    <div class="pz-step pz-s1" id="pz-s1">
      {% unless customer %}
        <div class="pz-login-wrap">
          <svg width="56" height="56" viewBox="0 0 48 48" fill="none"><rect x="8" y="6" width="24" height="30" rx="2" stroke="currentColor" stroke-width="2"/><path d="M16 36v4h24V14h-8" stroke="currentColor" stroke-width="2"/><circle cx="20" cy="18" r="4" stroke="currentColor" stroke-width="2"/><path d="M12 30c0-4.418 3.582-8 8-8s8 3.582 8 8" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
          <h2 class="h3">Quadro Personalizado</h2>
          <p>Para criar seu quadro com sua imagem, faça login primeiro.</p>
          <div class="pz-login-btns">
            <script src="{{ 'account-login-actions.js' | asset_url }}" type="module" fetchpriority="low"></script>
            <account-login-actions>{{ shop | login_button }}</account-login-actions>
            <a href="{{ routes.account_login_url }}" class="button button-secondary">Entrar com email</a>
          </div>
        </div>
      {% else %}
        <div class="pz-dropzone" id="pz-drop">
          <input type="file" id="pz-file" accept="image/*" hidden>
          <svg width="56" height="56" viewBox="0 0 64 64" fill="none"><rect x="8" y="16" width="48" height="36" rx="4" stroke="currentColor" stroke-width="2"/><circle cx="22" cy="28" r="4" stroke="currentColor" stroke-width="2"/><path d="M8 42l12-10 8 8 8-6 20 14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><path d="M32 8v16M26 12l6-6 6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <p class="pz-dropzone__title">Envie sua imagem</p>
          <p class="pz-dropzone__sub">Arraste aqui ou clique para selecionar · qualidade original preservada</p>
          <button class="button" id="pz-select-btn" type="button">Selecionar arquivo</button>
        </div>
      {% endunless %}
    </div>

    <!-- Step 2: Imagem inteira + seletor de enquadramento -->
    <div class="pz-step pz-s2" id="pz-s2" hidden>
      <div class="pz-img-stage" id="pz-img-stage">
        <img id="pz-full-img" src="" alt="" draggable="false">
        <!-- frame selector: a janela que o usuário posiciona sobre a imagem -->
        <div id="pz-frame-sel"></div>
        <div class="pz-fsel-ch" data-corner="nw"></div>
        <div class="pz-fsel-ch" data-corner="ne"></div>
        <div class="pz-fsel-ch" data-corner="sw"></div>
        <div class="pz-fsel-ch" data-corner="se"></div>
      </div>
      <div class="pz-crop-ctrl">
        <div>
          <h3>Escolha o tamanho</h3>
          <p>Posicione e redimensione a janela sobre a parte da imagem que deseja enquadrar</p>
        </div>
        <div class="pz-size-grid" id="pz-size-grid">
          <button class="pz-size-card" data-size="20x30cm" data-w="20" data-h="30" type="button">
            <div class="pz-size-card__box" style="width:28px;height:42px"></div>
            <span class="pz-size-card__name">20×30 cm</span>
          </button>
          <button class="pz-size-card" data-size="30x40cm" data-w="30" data-h="40" type="button">
            <div class="pz-size-card__box" style="width:33px;height:44px"></div>
            <span class="pz-size-card__name">30×40 cm</span>
          </button>
          <button class="pz-size-card" data-size="40x60cm" data-w="40" data-h="60" type="button">
            <div class="pz-size-card__box" style="width:28px;height:42px"></div>
            <span class="pz-size-card__name">40×60 cm</span>
          </button>
          <button class="pz-size-card" data-size="60x90cm" data-w="60" data-h="90" type="button">
            <div class="pz-size-card__box" style="width:28px;height:42px"></div>
            <span class="pz-size-card__name">60×90 cm</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Step 3: Preview da moldura -->
    <div class="pz-step pz-s3" id="pz-s3" hidden>
      <div class="pz-frame-stage" id="pz-frame-stage">
        <div class="pz-frame-inner" id="pz-frame-inner">
          <img class="pz-artwork" id="pz-artwork" src="" alt="">
          <img class="pz-moldura-img" id="pz-moldura" src="{{ 'moldura_white_fixed.png' | asset_url }}" alt="">
        </div>
      </div>
      <div class="pz-frame-ctrl">
        <div class="pz-s3-size-info" id="pz-s3-size-info">
          <p class="pz-opt-label" style="opacity:.45">Tamanho selecionado</p>
          <p id="pz-s3-size-label" style="font-size:var(--font-size--lg);font-weight:600;margin:4px 0 0">—</p>
        </div>
        <div>
          <p class="pz-opt-label">Moldura: <strong id="pz-frame-label">Branca</strong></p>
          <div class="pz-swatches">
            <button class="pz-swatch pz-swatch--white active" data-frame="white" data-label="Branca" title="Branca" type="button"></button>
            <button class="pz-swatch pz-swatch--black" data-frame="black" data-label="Preta" title="Preta" type="button"></button>
            <button class="pz-swatch pz-swatch--oak" data-frame="oak" data-label="Madeira" title="Madeira" type="button"></button>
          </div>
        </div>
        <div class="pz-sil-wrap" id="pz-sil-wrap">
          <img src="{{ 'tamanho.jpg' | asset_url }}" alt="Comparação de tamanhos" onerror="document.getElementById('pz-sil-wrap').style.display='none'">
        </div>
        <button class="button pz-buy-btn" id="pz-buy" type="button" disabled>Comprar</button>
      </div>
    </div>

    <!-- Footer -->
    <p class="pz-error" id="pz-error" hidden></p>
    <div class="pz-ft">
      <button class="pz-ft__back" id="pz-back" hidden type="button">
        <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M9 2L4 7l5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Voltar
      </button>
      <div class="pz-ft__center">
        <div class="pz-ft__dots">
          <div class="pz-ft__dot active" id="pz-dot-1"></div>
          <div class="pz-ft__dot" id="pz-dot-2"></div>
          <div class="pz-ft__dot" id="pz-dot-3"></div>
        </div>
        <span class="pz-ft__label" id="pz-step-label">Etapa 1 de 3</span>
      </div>
      <div class="pz-ft__next">
        <button class="button" id="pz-next" type="button" disabled>
          Próximo
          <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>
    </div>

  </div>
</div>

<script>
(function () {
  'use strict';
  const clamp = (v, a, b) => Math.min(Math.max(v, a), b);

  const modal = document.getElementById('pz-modal');
  if (!modal) return;

  const frameUrls = {
    white: {{ 'moldura_white_fixed.png' | asset_url | json }},
    black: {{ 'moldura_black_fixed.png' | asset_url | json }},
    oak:   {{ 'moldura_oak_fixed.png'   | asset_url | json }},
  };

  /* ── Estado ── */
  let step = 1;
  let objectUrl = null;
  let uploadPromise = null;
  let selW = 2, selH = 3, selectedSize = null, selectedFrame = 'white';
  /* frame selector: posição e tamanho em px dentro do img-stage */
  let fL = 0, fT = 0, fW = 0, fH = 0;
  /* drag frame */
  let dragFrame = false, dfSX = 0, dfSY = 0, dfFL = 0, dfFT = 0;
  /* drag corner */
  let cornerDrag = null, cdSX = 0, cdSY = 0, cdFL = 0, cdFT = 0, cdFW = 0, cdFH = 0;
  const CH = 11; /* metade de 22px */

  /* ── Elementos ── */
  const s1         = document.getElementById('pz-s1');
  const s2         = document.getElementById('pz-s2');
  const s3         = document.getElementById('pz-s3');
  const imgStage   = document.getElementById('pz-img-stage');
  const fullImg    = document.getElementById('pz-full-img');
  const frameSel   = document.getElementById('pz-frame-sel');
  const artworkImg = document.getElementById('pz-artwork');
  const frameInner = document.getElementById('pz-frame-inner');
  const molduraImg = document.getElementById('pz-moldura');
  const nextBtn    = document.getElementById('pz-next');
  const backBtn    = document.getElementById('pz-back');
  const stepLabel  = document.getElementById('pz-step-label');
  const buyBtn     = document.getElementById('pz-buy');
  const errorEl    = document.getElementById('pz-error');

  const cornerEls = {
    nw: imgStage.querySelector('[data-corner="nw"]'),
    ne: imgStage.querySelector('[data-corner="ne"]'),
    sw: imgStage.querySelector('[data-corner="sw"]'),
    se: imgStage.querySelector('[data-corner="se"]'),
  };

  /* ── Open / Close ── */
  function openModal() { modal.removeAttribute('hidden'); document.body.classList.add('pz-open'); }
  function closeModal() { modal.setAttribute('hidden',''); document.body.classList.remove('pz-open'); resetModal(); }
  function resetModal() {
    if (objectUrl) { URL.revokeObjectURL(objectUrl); objectUrl = null; }
    uploadPromise = null; selectedSize = null; selW = 2; selH = 3;
    const fi = document.getElementById('pz-file');
    if (fi) fi.value = '';
    document.querySelectorAll('.pz-size-card').forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.pz-swatch').forEach((b,i) => b.classList.toggle('active', i===0));
    molduraImg.src = frameUrls.white; selectedFrame = 'white';
    goToStep(1);
  }

  document.getElementById('pz-close')?.addEventListener('click', closeModal);
  document.getElementById('pz-backdrop')?.addEventListener('click', closeModal);
  document.addEventListener('keydown', e => { if (e.key==='Escape' && !modal.hidden) closeModal(); });
  document.addEventListener('click', e => {
    const link = e.target.closest('a[href*="/pages/personalizados"]');
    if (!link) return;
    e.preventDefault(); openModal();
  });
  if (window.location.pathname.includes('/pages/personalizados')) openModal();

  /* ── Navegação ── */
  function goToStep(n) {
    step = n;
    s1.hidden = n!==1; s2.hidden = n!==2; s3.hidden = n!==3;
    backBtn.hidden = n===1;
    [1,2,3].forEach(i => document.getElementById('pz-dot-'+i).classList.toggle('active', i===n));
    stepLabel.textContent = 'Etapa '+n+' de 3';
    if (n===1) {
      nextBtn.innerHTML = 'Próximo <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      nextBtn.disabled = !objectUrl; nextBtn.style.display=''; buyBtn.style.display='none';
    } else if (n===2) {
      nextBtn.innerHTML = 'Próximo <svg width="13" height="13" viewBox="0 0 14 14" fill="none"><path d="M5 2l5 5-5 5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>';
      nextBtn.disabled = !selectedSize; nextBtn.style.display=''; buyBtn.style.display='none';
      if (objectUrl && fullImg.complete && fullImg.naturalWidth) {
        requestAnimationFrame(initFrameSel);
      }
    } else {
      nextBtn.style.display='none'; buyBtn.style.display=''; buyBtn.disabled=false;
      syncArtwork();
    }
    if (errorEl) errorEl.hidden=true;
  }

  backBtn.addEventListener('click', () => goToStep(step-1));
  nextBtn.addEventListener('click', () => { if (step===2 && !selectedSize) return; goToStep(step+1); });

  /* ── Upload ── */
  const fileInput = document.getElementById('pz-file');
  const selectBtn = document.getElementById('pz-select-btn');
  const dropZone  = document.getElementById('pz-drop');

  selectBtn?.addEventListener('click', e => { e.stopPropagation(); fileInput?.click(); });
  dropZone?.addEventListener('click', () => fileInput?.click());
  fileInput?.addEventListener('change', () => { if (fileInput.files[0]) handleFile(fileInput.files[0]); });
  dropZone?.addEventListener('dragover', e => { e.preventDefault(); dropZone.classList.add('drag-over'); });
  dropZone?.addEventListener('dragleave', () => dropZone.classList.remove('drag-over'));
  dropZone?.addEventListener('drop', e => {
    e.preventDefault(); dropZone.classList.remove('drag-over');
    const f = e.dataTransfer.files[0];
    if (f?.type.startsWith('image/')) handleFile(f);
  });

  function handleFile(file) {
    if (objectUrl) URL.revokeObjectURL(objectUrl);
    objectUrl = URL.createObjectURL(file);
    fullImg.src = objectUrl;
    uploadPromise = uploadToCloudinary(file);
    fullImg.onload = () => { fullImg.onload=null; goToStep(2); };
  }

  async function uploadToCloudinary(file) {
    const fd = new FormData();
    fd.append('file', file);
    fd.append('upload_preset', 'ipaperclub');
    const res = await fetch('https://api.cloudinary.com/v1_1/dp9wibnvk/image/upload', { method:'POST', body:fd });
    if (!res.ok) throw new Error('upload '+res.status);
    return (await res.json()).secure_url;
  }

  /* ── Frame selector ── */
  function getImgBounds() {
    const sw = imgStage.offsetWidth, sh = imgStage.offsetHeight;
    const nW = fullImg.naturalWidth  || 1;
    const nH = fullImg.naturalHeight || 1;
    const sc = Math.min(sw/nW, sh/nH);
    const iw = nW*sc, ih = nH*sc;
    return { offX:(sw-iw)/2, offY:(sh-ih)/2, iw, ih, sc };
  }

  function initFrameSel() {
    const b = getImgBounds();
    if (!b.iw) return;
    const fR = selW/selH;
    const pad = 0.82;
    if (b.iw/b.ih > fR) { fH=b.ih*pad; fW=fH*fR; }
    else                { fW=b.iw*pad; fH=fW/fR; }
    fL = b.offX + (b.iw-fW)/2;
    fT = b.offY + (b.ih-fH)/2;
    constrainFrame();
    applyFrameDom();
  }

  function constrainFrame() {
    const b = getImgBounds();
    fL = clamp(fL, b.offX, b.offX+b.iw-fW);
    fT = clamp(fT, b.offY, b.offY+b.ih-fH);
  }

  function applyFrameDom() {
    frameSel.style.left=fL+'px'; frameSel.style.top=fT+'px';
    frameSel.style.width=fW+'px'; frameSel.style.height=fH+'px';
    cornerEls.nw.style.left=(fL-CH)+'px'; cornerEls.nw.style.top=(fT-CH)+'px';
    cornerEls.ne.style.left=(fL+fW-CH)+'px'; cornerEls.ne.style.top=(fT-CH)+'px';
    cornerEls.sw.style.left=(fL-CH)+'px'; cornerEls.sw.style.top=(fT+fH-CH)+'px';
    cornerEls.se.style.left=(fL+fW-CH)+'px'; cornerEls.se.style.top=(fT+fH-CH)+'px';
  }

  function getCropParams() {
    const b = getImgBounds();
    return {
      x: Math.max(0, Math.round((fL-b.offX)/b.sc)),
      y: Math.max(0, Math.round((fT-b.offY)/b.sc)),
      w: Math.round(fW/b.sc),
      h: Math.round(fH/b.sc),
    };
  }

  /* drag — mover frame selector */
  frameSel.addEventListener('mousedown', e => {
    e.preventDefault();
    dragFrame=true; dfSX=e.clientX; dfSY=e.clientY; dfFL=fL; dfFT=fT;
    imgStage.style.cursor='grabbing';
  });
  frameSel.addEventListener('touchstart', e => {
    e.preventDefault(); e.stopPropagation();
    const t=e.touches[0];
    dragFrame=true; dfSX=t.clientX; dfSY=t.clientY; dfFL=fL; dfFT=fT;
  }, {passive:false});

  /* drag — redimensionar pelos cantos */
  function applyCornerDrag(dx) {
    const b = getImgBounds();
    const fR = selW/selH;
    const MIN = 60;
    let nFL=cdFL, nFT=cdFT, nFW=cdFW, nFH=cdFH;

    if (cornerDrag==='se')      { nFW=cdFW+dx; }
    else if (cornerDrag==='sw') { nFW=cdFW-dx; nFL=cdFL+cdFW-nFW; }
    else if (cornerDrag==='ne') { nFW=cdFW+dx; }
    else if (cornerDrag==='nw') { nFW=cdFW-dx; nFL=cdFL+cdFW-nFW; }

    nFW = Math.max(MIN, nFW);
    nFH = nFW/fR;

    /* para cantos de cima: ajusta topo */
    if (cornerDrag==='ne'||cornerDrag==='nw') nFT = cdFT+cdFH-nFH;

    /* constrain dentro da imagem */
    nFL = clamp(nFL, b.offX, b.offX+b.iw-nFW);
    nFT = clamp(nFT, b.offY, b.offY+b.ih-nFH);
    nFW = Math.min(nFW, b.offX+b.iw-nFL);
    nFH = nFW/fR;

    fL=nFL; fT=nFT; fW=nFW; fH=nFH;
    applyFrameDom();
  }

  Object.values(cornerEls).forEach(el => {
    el.addEventListener('mousedown', e => {
      e.preventDefault(); e.stopPropagation();
      cornerDrag=el.dataset.corner;
      cdSX=e.clientX; cdSY=e.clientY;
      cdFL=fL; cdFT=fT; cdFW=fW; cdFH=fH;
    });
    el.addEventListener('touchstart', e => {
      e.preventDefault(); e.stopPropagation();
      cornerDrag=el.dataset.corner;
      const t=e.touches[0];
      cdSX=t.clientX; cdSY=t.clientY;
      cdFL=fL; cdFT=fT; cdFW=fW; cdFH=fH;
    }, {passive:false});
  });

  window.addEventListener('mousemove', e => {
    if (cornerDrag)   { applyCornerDrag(e.clientX-cdSX); }
    else if (dragFrame) {
      fL=dfFL+(e.clientX-dfSX); fT=dfFT+(e.clientY-dfSY);
      constrainFrame(); applyFrameDom();
    }
  });
  window.addEventListener('mouseup', () => {
    dragFrame=false; cornerDrag=null; imgStage.style.cursor='';
  });
  imgStage.addEventListener('touchmove', e => {
    e.preventDefault();
    const t=e.touches[0];
    if (cornerDrag)   { applyCornerDrag(t.clientX-cdSX); }
    else if (dragFrame) {
      fL=dfFL+(t.clientX-dfSX); fT=dfFT+(t.clientY-dfSY);
      constrainFrame(); applyFrameDom();
    }
  }, {passive:false});
  imgStage.addEventListener('touchend', () => { dragFrame=false; cornerDrag=null; });

  /* ── Seleção de tamanho ── */
  document.getElementById('pz-size-grid')?.querySelectorAll('.pz-size-card').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedSize=btn.dataset.size; selW=+btn.dataset.w; selH=+btn.dataset.h;
      document.querySelectorAll('.pz-size-card').forEach(b => b.classList.toggle('active', b===btn));
      frameInner.style.setProperty('--pz-ratio', selW+'/'+selH);
      const lbl = document.getElementById('pz-s3-size-label');
      if (lbl) lbl.textContent = btn.querySelector('.pz-size-card__name').textContent;
      nextBtn.disabled=false;
      initFrameSel();
    });
  });

  /* ── Step 3 — Preview ── */
  function syncArtwork() {
    if (!objectUrl) return;
    const cp = getCropParams();
    artworkImg.style.objectPosition='50% 50%';
    artworkImg.src = objectUrl;
    artworkImg.onload = function() {
      artworkImg.onload=null;
      requestAnimationFrame(function() {
        if (!cp) return;
        const nW=fullImg.naturalWidth, nH=fullImg.naturalHeight;
        const fw=artworkImg.offsetWidth||1, fh=artworkImg.offsetHeight||1;
        const cs=Math.max(fw/nW, fh/nH);
        const ovX=nW*cs-fw, ovY=nH*cs-fh;
        const posX = ovX>0 ? clamp(cp.x*cs/ovX*100, 0, 100) : 50;
        const posY = ovY>0 ? clamp(cp.y*cs/ovY*100, 0, 100) : 50;
        artworkImg.style.objectPosition = posX+'% '+posY+'%';
      });
    };
    buyBtn.disabled=false;
  }

  document.querySelectorAll('.pz-swatch').forEach(btn => {
    btn.addEventListener('click', () => {
      selectedFrame=btn.dataset.frame;
      molduraImg.src=frameUrls[selectedFrame]||'';
      document.getElementById('pz-frame-label').textContent=btn.dataset.label;
      document.querySelectorAll('.pz-swatch').forEach(s => s.classList.toggle('active', s===btn));
    });
  });

  /* ── Comprar ── */
  buyBtn.addEventListener('click', addToCart);

  async function addToCart() {
    buyBtn.disabled=true; buyBtn.textContent='Enviando imagem…';
    if (errorEl) errorEl.hidden=true;

    let imageUrl;
    try { imageUrl = await uploadPromise; }
    catch {
      showError('Erro ao enviar a imagem. Verifique o preset do Cloudinary (deve ser "Unsigned").');
      buyBtn.disabled=false; buyBtn.textContent='Comprar'; return;
    }

    const cp = getCropParams();
    const finalUrl = buildCroppedUrl(imageUrl, cp);

    buyBtn.textContent='Adicionando ao carrinho…';
    let product;
    try {
      const r = await fetch('/products/quadro-personalizado.js');
      if (!r.ok) throw new Error();
      product = await r.json();
    } catch {
      showError('Produto não encontrado. Entre em contato com o suporte.');
      buyBtn.disabled=false; buyBtn.textContent='Comprar'; return;
    }

    const frameLabel = {white:'Branca',black:'Preta',oak:'Madeira'}[selectedFrame];
    const variant = product.variants.find(v => {
      const opts=[v.option1,v.option2,v.option3].filter(Boolean);
      return opts.includes(selectedSize) && opts.includes(frameLabel);
    });
    if (!variant) {
      showError('Combinação indisponível. Tente outra opção.');
      buyBtn.disabled=false; buyBtn.textContent='Comprar'; return;
    }

    try {
      const r = await fetch('/cart/add.js', {
        method:'POST',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({ items:[{ id:variant.id, quantity:1, properties:{
          'Imagem personalizada':finalUrl, 'Tamanho':selectedSize, 'Moldura':frameLabel
        }}]}),
      });
      if (!r.ok) throw new Error(await r.text());
      window.location.href='/cart';
    } catch(err) {
      showError('Erro ao adicionar ao carrinho. Verifique o estoque das variantes.');
      buyBtn.disabled=false; buyBtn.textContent='Comprar';
    }
  }

  function buildCroppedUrl(url, cp) {
    if (!cp||(!cp.x&&!cp.y)) return url;
    return url.replace('/upload/', '/upload/c_crop,x_'+cp.x+',y_'+cp.y+',w_'+cp.w+',h_'+cp.h+'/');
  }

  function showError(msg) { if (!errorEl) return; errorEl.textContent=msg; errorEl.hidden=false; }

  goToStep(1);
})();
</script>
